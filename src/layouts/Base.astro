---
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
interface Props {
  title: string;
  description: string;
  /** Whether the page has a canonical address (not the 404 page). */
  canonical?: boolean;
  /** Whether the main column runs the full width of the window (the map page). */
  wide?: boolean;
}
const { title, description, canonical = true, wide = false } = Astro.props;
// Canonical addresses are on foothold.milux.co.uk and end in a slash, as served.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(path, 'https://foothold.milux.co.uk').toString();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-800.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
