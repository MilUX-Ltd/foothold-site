---
// The home page: the map filling the window with the headline over it, then
// the pack's jobs, step by step. Built from the map file at build time; the
// map's own script moves it from the landing state into the map.
import Base from '../layouts/Base.astro';
import MapExplorer from '../components/MapExplorer.astro';
import { listRoutes, loadMap } from '../lib/map';

const routes = listRoutes(loadMap());
---
<Base
  title="Foothold: a ready-to-go structure for a small defence business"
  description="Foothold is a free pack of notes and AI skills for founders of small UK defence businesses: folders for your records, skills that do the jobs, and a map of the defence organisations you deal with."
  stage
>
  <MapExplorer landing />

  <section class="page-section" aria-labelledby="routes-heading">
    <h2 id="routes-heading">Jobs, step by step</h2>
    <p>A route is a job that takes more than one skill. Each step names the skill and says what it does.</p>
    <div class="routes">
      {routes.map((route, i) => (
        <article class="card route" aria-labelledby={`route-${i}`}>
          <div class="card-head"><h3 id={`route-${i}`}>{route.name}</h3></div>
          <ol class="route-steps">
            {route.steps.map((step) => (
              <li class="route-step">
                <div>
                  <span class="route-skill">{step.skill}</span>
                  <p class="route-does">{step.does}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="route-more"><a href={`/map/?view=jobs&route=${encodeURIComponent(route.id)}`} aria-describedby={`route-${i}`}>See it on the map</a></p>
        </article>
      ))}
    </div>
  </section>
</Base>
