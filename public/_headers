# Security headers baseline. Asserted by tests/unit/security-headers.test.ts
# and checked after every deploy by scripts/check-deploy.mjs; change all together.
# The page loads nothing from any other host and runs no script, so the policy
# starts from nothing and allows this site only what the page needs: styles,
# images and fonts from itself. Later cards widen it one directive at a time.
/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
